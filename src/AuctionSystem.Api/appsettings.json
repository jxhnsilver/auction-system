{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=db_host;Port=db_port;Database=db_name;Username=db_user;Password=db_password"
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-min-64-characters-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "Issuer": "Issuer",
    "Audience": "Audience",
    "ExpirationInSeconds": 3600
  }
}
